# Supabase — انسخ هذا الملف إلى .env واملأ القيم من لوحة مشروع Supabase
# ⚠️ لا تضع مفاتيح حقيقية هنا — هذا الملف يُرفع إلى git
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# المفتاح العام (publishable / anon) — للعميل
SUPABASE_KEY=your-anon-publishable-key

# 🔒 مفتاح الخدمة (service_role) — خادمي فقط، لا يُرفع.
# تقرأه @nuxtjs/supabase تلقائيّاً عبر serverSupabaseServiceRole (للعمليات الإدارية كإنشاء الحسابات).
NUXT_SUPABASE_SECRET_KEY=your-service-role-key
